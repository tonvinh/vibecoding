# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# File .env KHÔNG được đưa lên git (đã có trong .gitignore).

# --- Tài khoản admin (trang /admin) ---
# Thiếu một trong hai, hoặc mật khẩu ngắn hơn 8 ký tự: trang admin bị khoá hoàn toàn.
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# --- Database PostgreSQL ---
# Lưu ý: mật khẩu database chỉ được áp dụng ở lần đầu tạo volume.
# Muốn đổi sau đó phải đổi trong PostgreSQL, hoặc xoá volume (mất dữ liệu).
POSTGRES_USER=dapchuot
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=dapchuot
